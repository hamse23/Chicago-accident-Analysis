  <Source dwd:design-time-name="cf9e9eae-1bcb-49ba-afa3-ea5c798c5d19">
    <DataSourceViewID>Group ID 34 DB</DataSourceViewID>
  </Source>
  <MdxScripts>
    <MdxScript dwd:design-time-name="4e3700f0-3760-4d41-a516-092be37e6893">
      <ID>MdxScript</ID>
      <Name>MdxScript</Name>
      <CreatedTimestamp>0001-01-01T00:00:00Z</CreatedTimestamp>
      <LastSchemaUpdate>0001-01-01T00:00:00Z</LastSchemaUpdate>
      <Commands>
        <Command>
          <Text>/*
The CALCULATE command controls the aggregation of leaf cells in the cube.
If the CALCULATE command is deleted or modified, the data within the cube is affected.
You should edit this command only if you manually specify how the cube is aggregated.
*/
CALCULATE;               
CREATE MEMBER CURRENTCUBE.[Measures].[Max Damage Value]
 AS MAX(
        NONEMPTY(
            [Dim people].[Person ID].[Person ID].Members,
            [Measures].[Total Damage Cost]
        ),
        [Measures].[Total Damage Cost] ), 
FORMAT_STRING = "Standard", 
VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'Vehicle';               
CREATE MEMBER CURRENTCUBE.[Measures].[Max Damage Person]
 AS HEAD(
        TOPCOUNT(
            NONEMPTY(
                [Dim people].[Person ID].[Person ID].Members,
                [Measures].[Total Damage Cost]
            ),
            1,
            [Measures].[Total Damage Cost]
        )
    ).Item(0).Properties("Key"), 
VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'Vehicle';               
CREATE MEMBER CURRENTCUBE.[Measures].[Max Damage Vehicle Type]
 AS HEAD(
    TOPCOUNT(
        NONEMPTY(
            [Dim Vehicle].[VEHICLE TYPE].Members,
            [Measures].[Total Damage Cost]
        ),
        1,
        [Measures].[Total Damage Cost]
    )
).Item(0).Name, 
VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'Vehicle';                                 
CREATE MEMBER CURRENTCUBE.[Measures].[Avg Damage Per Crash Per Person]
 AS IIF(
        [Measures].[Accident count]&gt; 0,
         [Measures].[ Damage Per Crash Per Person]/ [Measures].[Accident count] ,
        NULL
    ), 
VISIBLE = 1;                         
CREATE MEMBER CURRENTCUBE.[Measures].[Avg per person per year]
 AS AVG(
        [Dim_date].[Year].CurrentMember,
        [Measures].[Damage Per Person Per Crash]
    ), 
VISIBLE = 1;                                           
CREATE MEMBER CURRENTCUBE.[Measures].[Damage Per Person Per Crash]
 AS IIF(
    [Measures].[Person Involved no] = 0,
    NULL,
     [Measures].[Total Damage Cost]/ [Measures].[Person Involved no]
), 
VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'Person';                                           
CREATE MEMBER CURRENTCUBE.[Measures].[Current Quarter Vehiclesr]
 AS [Measures].[Vehicle Involved no], 
VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'Vehicle';                      
CREATE MEMBER CURRENTCUBE.[Measures].[Previous Year Quarter Vehicle Involvement]
 AS SUM(
        ([Dim Date].[Year].CurrentMember.PrevMember,
         [Dim Date].[Crash Quarter].CurrentMember),
        [Measures].[Vehicle Involved no]
    ), 
VISIBLE = 1;                                        
CREATE MEMBER CURRENTCUBE.[Measures].[Vehicle Involvement Increase %]
 AS IIF(
    [Measures].[Previous Year Quarter Vehicle Involvement] &gt; 0,
    (
        ([Measures].[Vehicle Involved no] - [Measures].[Previous Year Quarter Vehicle Involvement]) 
        / [Measures].[Previous Year Quarter Vehicle Involvement]
    ) * 100,
    NULL
), 
FORMAT_STRING = "0.00%", 
VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'Vehicle'  ;                      
CREATE MEMBER CURRENTCUBE.[Measures].[ Vehicles Previous Year Quarter %]
 AS IIF(
        [Measures].[Previous Year Quarter Vehicle Involvement] &gt; 0,
        ([Measures].[Vehicle Involved no] - [Measures].[Previous Year Quarter Vehicle Involvement])
        / [Measures].[Previous Year Quarter Vehicle Involvement] * 100,
        NULL
    ), 
FORMAT_STRING = "#,##0.00%;-#,##0.00%", 
VISIBLE = 1  ;         
                        
CREATE MEMBER CURRENTCUBE.[Measures].[Sum Damage Per Crash Per Person]
 AS SUM(
        [Fact Damage].[RD NO].Members,
        [Measures].[Damage Per Person Per Crash]
    ), 
VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'Person'; </Text>
        </Command>
      </Commands>
    </MdxScript>
  </MdxScripts>
</Cube>